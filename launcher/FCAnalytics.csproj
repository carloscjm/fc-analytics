<Project Sdk="Microsoft.NET.Sdk">

  <!-- App de controle do FC Analytics no Windows: instala o ambiente Python, sobe o backend,
       abre o painel no navegador e busca atualizações nos Releases do GitHub (Velopack). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FCAnalytics</AssemblyName>
    <RootNamespace>FCAnalytics</RootNamespace>
    <StartupObject>FCAnalytics.Program</StartupObject>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.0.0</Version>
    <Product>FC Analytics</Product>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
